# Copy to .env and adjust. Every value here has a sensible default.

PORT=3000
HOST=0.0.0.0
REDIS_URL=redis://localhost:6379

# Who is allowed to tell us the client's IP via X-Forwarded-For?
#   false              -> nobody; use the TCP socket address (local dev, no proxy)
#   1                  -> trust exactly one proxy hop (most PaaS: Render, Fly, Heroku)
#   loopback           -> trust a proxy on the same machine (nginx on localhost)
#   10.0.0.0/8,loopback -> comma list of trusted proxy IPs/subnets
#   true               -> trust everything (DANGEROUS: anyone can spoof their court)
TRUST_PROXY=false
