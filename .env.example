# Copy to .env and adjust. Every value has a sensible default.
# Full explanations: docs/DEPLOYMENT.md

# ---- Server -------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# ---- Redis --------------------------------------------------------------
# Local:   redis://localhost:6379
# Hosted:  rediss://default:<password>@<host>:<port>   (note rediss = TLS)
# Needs Redis 7+ (uses EXPIRE ... NX).
REDIS_URL=redis://localhost:6379

# ---- Client IP / proxies --------------------------------------------------
# Who is allowed to tell us the client's IP via X-Forwarded-For?
#   false               nobody; use the TCP socket address (local dev, no proxy)
#   1                   trust exactly one proxy hop (Render, Fly.io, Railway, Heroku, one nginx)
#   2                   two hops (e.g. Cloudflare -> load balancer -> app)
#   loopback            a proxy on the same machine (nginx on localhost)
#   10.0.0.0/8,loopback a comma list of trusted proxy IPs/subnets
#   true                trust everything (DANGEROUS: anyone can pick their court)
TRUST_PROXY=false

# ---- Timings ----------------------------------------------------------------
# TEXT_TTL_S=1800             shared text disappears this long after the last edit
# CODE_TTL_S=1800             court code lifetime after the last device leaves
# TEXT_MAX_LENGTH=50000       characters
# PRESENCE_HEARTBEAT_MS=20000
# PRESENCE_STALE_MS=60000

# ---- WebRTC: STUN / TURN -------------------------------------------------------
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
#
# TURN relays traffic when a direct path is impossible. Leave unset for STUN only.
# TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# Either static credentials (simple, but anyone can read them from /api/rtc-config):
# TURN_USERNAME=
# TURN_CREDENTIAL=
# ...or a shared secret for short-lived credentials (recommended; coturn
# `use-auth-secret` + `static-auth-secret=<same value>`):
# TURN_SECRET=
# TURN_TTL_S=86400
